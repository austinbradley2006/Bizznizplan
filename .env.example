# Optional overrides. Session tokens are stored by pyhood at ~/.pyhood/session.json
# after you run: pyhood setup login

# BOT_DRY_RUN=true
# BOT_LIVE_TRADING_ENABLED=false

# Telegram (easiest way to text your bot)
# TELEGRAM_BOT_TOKEN=123456:ABC...   # from @BotFather on Telegram

# Twilio SMS (real text messages)
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
